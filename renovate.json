{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Brussels",

  "automerge": false,
  "schedule": ["before 9am on monday"],
  "prConcurrentLimit": 5,

  "nix": {
    "enabled": true,
    "lockFileMaintenance": { "enabled": true }
  },

  "packageRules": [
    {
      "matchManagers": ["docker-compose", "dockerfile", "terraform", "custom.regex"],
      "matchUpdateTypes": ["patch"],
      "groupName": "patch updates"
    },
    {
      "description": "Traefik terminates TLS for everything. Keep it visible and on its own.",
      "matchPackageNames": ["traefik"],
      "groupName": null,
      "labels": ["front-door"]
    },
    {
      "description": "Zitadel is auth for every service. Never batch it with anything.",
      "matchPackageNames": ["ghcr.io/zitadel/zitadel", "ghcr.io/zitadel/zitadel-login"],
      "groupName": null,
      "labels": ["auth"]
    },
    {
      "description": "Postgres majors need a dump/restore, not a tag bump.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["postgres"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Own images, built elsewhere -- the PR here is only the deploy.",
      "matchPackageNames": ["wim07101993/score", "wim07101993/score-frontend"],
      "groupName": "score"
    }
  ],

  "customManagers": [
    {
      "description": "Image tags held in OpenTofu variables. The built-in terraform manager tracks provider versions in required_providers; it does not reliably see an image string in a variable default, so it is annotated explicitly.",
      "customType": "regex",
      "managerFilePatterns": ["/^tofu/.+\\.tf$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+?)\\s+depName=(?<depName>[^\\s]+?)(\\s+versioning=(?<versioning>[^\\s]+?))?\\s*\\n[\\s\\S]*?default\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}docker{{/if}}"
    }
  ]
}
