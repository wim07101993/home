# mindy:/etc/fstab -- the NON-SYSTEM entries.
#
# The root, ESP and cdrom lines are left out: they are set up by the image and
# are not ours to describe. Everything below is.
#
# THIS FILE IS NOT DEPLOYED. Copy the blocks into /etc/fstab on mindy, then:
#
#     systemctl daemon-reload
#     systemctl restart remote-fs.target
#
# Nothing enforces that, which is exactly how the previous version of this file
# came to describe a machine that no longer existed -- see "History" at the
# bottom.
#
# These mounts are a PRECONDITION for tofu, not a product of it. kopia's /data
# bind and filebrowser's /files tree are directories that only contain anything
# because systemd mounted these first; the docker provider cannot express that
# ordering, and a container started against an unmounted path backs up, or
# serves, nothing. It does not error either.

######################################
# RAFIKI -- the Hetzner volume
######################################
#
# 99 GB holding photos (immich), documents and audio (filebrowser), and the
# shared postgres data directory. Addressed by-id rather than /dev/sdb, which
# is assigned in attach order.
#
# `nofail` so a detached volume does not hold up boot. That is the right trade
# here -- but note it means mindy boots happily with /mnt/rafiki EMPTY, and
# immich and filebrowser then start against empty directories.

/dev/disk/by-id/scsi-0HC_Volume_103225027 /mnt/rafiki ext4 discard,nofail,defaults 0 0

######################################
# NFS FROM SAMSON (100.71.248.106, over Tailscale)
######################################
#
# Only what is still served from samson. Everything else moved to rafiki in
# September 2026 -- see History.
#
# Options rationale:
#
#   x-systemd.automount + x-systemd.mount-timeout=15
#       Mounted on first access rather than at boot, and an unreachable samson
#       FAILS after 15s instead of blocking forever. Without it a `hard` mount
#       makes stat(2) hang indefinitely, which is what took filebrowser down on
#       2026-08-09: it blocked in setupSources() before ever opening its HTTP
#       listener, so the container looked up and served nothing.
#
#       REQUIRES bind-propagation=rslave on any docker bind covering these
#       paths, because a mount established after container start is otherwise
#       invisible inside it. Verified 2026-09-23: filebrowser's /files and
#       kopia's /data both have it, and both modules say why.
#
#   hard
#       Deliberate. `soft` returns EIO on timeout, which risks silent data loss
#       on writes -- the wrong trade for a file server.
#
#   timeo=150,retrans=3
#       15s per RPC retry. Detects and recovers from a samson outage in ~45s
#       rather than the ~7.5min that timeo=900,retrans=5 gives.
#
#   nfsvers=3
#       Pinned to today's behaviour. Moving to 4.2 is worth evaluating -- one
#       port instead of rpcbind/mountd on random ones, better recovery from a
#       flapping link -- but samson's exports need checking for a v4
#       pseudo-root first.

# audio-archive: 32 GB, deliberately left on samson when audio moved to rafiki.
# Mounted TWICE, for the two consumers, because each has its own tree.
100.71.248.106:/export/audio-archive /docker-volumes/filebrowser/files/audio-archive nfs _netdev,x-systemd.automount,x-systemd.mount-timeout=15,hard,timeo=150,retrans=3,nfsvers=3 0 0
100.71.248.106:/export/audio-archive /docker-volumes/kopia/data/audio-archive        nfs _netdev,x-systemd.automount,x-systemd.mount-timeout=15,hard,timeo=150,retrans=3,nfsvers=3 0 0

# For kopia only -- neither is served by filebrowser.
100.71.248.106:/export/backups /docker-volumes/kopia/data/backups nfs _netdev,x-systemd.automount,x-systemd.mount-timeout=15,hard,timeo=150,retrans=3,nfsvers=3 0 0
100.71.248.106:/export/media   /docker-volumes/kopia/data/media   nfs _netdev,x-systemd.automount,x-systemd.mount-timeout=15,hard,timeo=150,retrans=3,nfsvers=3 0 0

