# SHA256 fingerprint of mindy's kopia server certificate, no colons.
# Not a secret -- it pins which server the client will talk to.
# Obtain it during phase 1 of README.md:
#   docker exec kopia openssl x509 -in /app/config/kopia.cert -noout \
#     -fingerprint -sha256 | sed 's/://g' | cut -f 2 -d =
KOPIA_SERVER_CERT_FINGERPRINT=79682bf681789f9a756a266ecc78e55beff691da253ee3b00139f0facbd4dd88

# How often to snapshot. 21600 = 6h.
SNAPSHOT_INTERVAL_SECONDS=21600
