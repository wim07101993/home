# Rendered by ./main.tf. Templated rather than copied because it carries the
# database password, the JWT secret and the OIDC client.
name: "selfhosted"
is_done_tick_dot_com: false
# Refuses password sign-up. Accounts still come from zitadel on first sign-in;
# who may sign in is the `family` role on the `tasks` project there.
is_user_creation_disabled: true

# Notifications go through the webhook, not these.
telegram:
  token: ""
pushover:
  token: ""
email:
  host:
  port:
  key:
  email:
  app_host:
  log_raw_url: false

database:
  type: "postgres"
  migration: true
  host: "db"
  port: 5432
  user: "${db_user}"
  password: "${db_password}"
  name: "${db_name}"

jwt:
  secret: "${jwt_secret}"
  session_time: 168h
  max_refresh: 1440h

server:
  port: 2021
  read_timeout: 10s
  write_timeout: 10s
  rate_period: 60s
  rate_limit: 300
  cors_allow_origins:
    - "https://${host}"
  serve_frontend: true
  serve_swagger: false
  # The base of the calendar subscription links it hands out.
  public_host: "https://${host}"

logging:
  level: "info"
  encoding: "json"
  development: false

scheduler_jobs:
  due_job: 30m
  overdue_job: 3h
  pre_due_job: 3h

# Sign-in through zitadel only.
oauth2:
  client_id: "${client_id}"
  client_secret: "${client_secret}"
  auth_url: "https://auth.wvl.app/oauth/v2/authorize"
  token_url: "https://auth.wvl.app/oauth/v2/token"
  user_info_url: "https://auth.wvl.app/oidc/v1/userinfo"
  redirect_url: "https://${host}/auth/oauth2"
  scopes: ["openid", "profile", "email"]
  pkce: false
  name: "Home"
disable_password_auth: true

realtime:
  enabled: true
  sse_enabled: true
  heartbeat_interval: 60s
  connection_timeout: 120s
  max_connections: 1000
  max_connections_per_user: 5
  event_queue_size: 2048
  cleanup_interval: 2m
  stale_threshold: 5m
  enable_compression: true
  enable_stats: true
  allowed_origins:
    - "https://${host}"

# Reminders go to ntfy on bumba, over the internet: the circle webhook, set in
# Donetick's settings to `tofu output -raw donetick_webhook_url`.
webhook:
  timeout: 5s
  queue_size: 100
  block_private_networks: true
  allow_loopback: false
  require_https: true
  signing_secret: ""
  rate_limit_per_minute: 60
  failure_threshold: 10
  failure_cooldown: 15m
  max_response_bytes: 65536

mcp:
  enabled: false
