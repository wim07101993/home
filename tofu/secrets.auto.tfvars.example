# Copy to `secrets.auto.tfvars` and fill in. Then stop being prompted.
#
#   cp secrets.auto.tfvars.example secrets.auto.tfvars
#   $EDITOR secrets.auto.tfvars
#
# `*.auto.tfvars` is loaded by tofu automatically -- no -var-file flag -- and is
# gitignored by the `*.tfvars` rule in ../.gitignore, while this .example is
# kept by the `!*.tfvars.example` exception. Check that before committing:
#
#   git check-ignore -v secrets.auto.tfvars     # must print a match
#
# env.sh skips prompting for anything defined here. It has to: tfvars takes
# PRECEDENCE over TF_VAR_ environment variables, so a prompted answer for a
# variable that is also in this file would be read and then silently ignored.
#
# THREE VALUES CANNOT LIVE HERE. They are needed before, or outside of, the
# variable system:
#
#   TF_VAR_state_passphrase   read by the `encryption` block, which is evaluated
#                             earlier than variable loading
#   TOFU_STATE_DB_PASSWORD    backend configuration -- not a tofu variable
#     (or PG_CONN_STR)
#   HCLOUD_TOKEN              read from the environment by the hcloud provider
#
# Keep those three in your shell, from a vault if you have one:
#
#   export TF_VAR_state_passphrase="$(rbw get 'OpenTofu state')"
#
# This file is as sensitive as state itself. It is plaintext on disk with no
# passphrase in front of it, which is the trade for not being asked every time.

# --- postgres -------------------------------------------------------------
# Three DIFFERENT superuser passwords, one per cluster. Not the tofu_state
# backend role -- see env.sh on why those are kept apart.
bumba_pg_superuser_password  = ""
mindy_pg_superuser_password  = ""
immich_pg_superuser_password = "" # immich's own postgres, mindy:5434

# --- mailgun --------------------------------------------------------------
# One key instead of one SMTP password per service: tofu mints the SMTP
# credentials itself (modules/services/gatus/mail.tf, modules/zitadel/mail.tf),
# so there is no SMTP password here.
#
# Alerting is a silent dependency -- if this is wrong, gatus keeps monitoring
# and the dashboard stays correct, you simply stop being told. That is the
# failure that let the array incident run unreported for two days. Verify a
# real alert arrives after the first apply rather than assuming it.
mailgun_api_key = ""
